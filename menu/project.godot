; PENTA menu — Godot 4 project.
; Kept minimal on purpose: the input map is built in code (core/input_router.gd)
; so it stays readable and diffable rather than living in this file as blobs.

config_version=5

[application]

config/name="PENTA"
config/description="Console menu"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043, 0.051, 0.063, 1)

[autoload]

Tokens="*res://core/tokens.gd"
Ipc="*res://core/ipc_client.gd"
Router="*res://core/input_router.gd"
Art="*res://core/art.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.051, 0.063, 1)
anti_aliasing/quality/msaa_2d=1
