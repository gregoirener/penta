#!/bin/sh
# Runs inside the image after packages are installed.
set -eu

echo "==> creating the penta user"
# No password: this account cannot be logged into interactively, only started
# by greetd. Dev access is by SSH key.
useradd --create-home \
        --groups input,video,audio,render \
        --shell /usr/bin/false \
        penta
passwd --lock penta

echo "==> directories"
install -d -m 0755 /opt/penta /opt/penta/daemon
install -d -m 0755 /games /var/lib/penta /var/lib/penta/art /var/lib/penta/captures
install -d -m 0755 /games/native /games/roms
chown -R penta:penta /var/lib/penta /games

echo "==> enabling services"
systemctl enable pentad.service
systemctl enable greetd.service
systemctl enable bluetooth.service
systemctl enable NetworkManager.service
systemctl enable sshd.service
# Creates the data + swap partitions against the real disk size on first boot,
# and relocates the GPT backup header that dd left mid-disk.
systemctl enable systemd-repart.service
systemctl enable penta-selftest.service

systemctl set-default penta.target

echo "==> ssh (key-only, for the dev loop)"
install -d -m 0700 /root/.ssh
cat > /etc/ssh/sshd_config.d/10-penta.conf <<'SSHD'
# Key-only root access. `penta` is a service account with no shell, so the
# dev loop (tools/devsync.sh) comes in here. There is no password to guess.
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
SSHD

echo "==> boot splash"
plymouth-set-default-theme penta || echo "penta theme missing; leaving default"

echo "==> done"
