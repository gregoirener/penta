# PENTA boot splash.
#
# Black, centred mark, a slow breath. No progress bar, no spinner, no text:
# a console does not show you its boot process, and any text here would be the
# only Linux the user ever sees.
#
# The background colour must match Tokens.BG in the menu exactly, or the
# handoff from Plymouth to the menu flashes.

Window.SetBackgroundTopColor(0.043, 0.051, 0.063);
Window.SetBackgroundBottomColor(0.043, 0.051, 0.063);

logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetZ(10);

progress = 0;

fun refresh_callback() {
        progress++;
        # ~0.35 Hz breath between 62% and 100% opacity. Slow enough to read as
        # "alive", not as "loading".
        phase = Math.Sin(progress / 48);
        logo.sprite.SetOpacity(0.81 + 0.19 * phase);
}

Plymouth.SetRefreshFunction(refresh_callback);

# Password prompts should never appear — there is no encrypted volume and no
# login — but if one ever does, fail visibly rather than hanging on a black
# screen with no explanation.
fun display_password_callback(prompt, bullets) {
        logo.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);
