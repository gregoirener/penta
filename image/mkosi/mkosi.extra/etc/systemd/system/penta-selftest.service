[Unit]
Description=PENTA first-boot hardware self-check
# Was `After=... penta.target` while being WantedBy=multi-user.target, which
# reads as "run after the thing that is started later than me". It meant the
# probes ran at an unpredictable point, before the data partition was mounted,
# and reported failures that were only true because it was too early.
After=multi-user.target bluetooth.service penta-mount-data.service
Wants=bluetooth.service
# Only ever runs once; the flag is what makes it a *first*-boot check.
ConditionPathExists=!/var/lib/penta/selftest.json

[Service]
Type=oneshot
ExecStart=/usr/bin/penta-selftest
RemainAfterExit=yes
# penta.target does not wait on its Wants=, so this never delays the menu.
# The timeout is belt and braces on top of the per-probe ones: even a total
# wedge costs 120 seconds once, not a boot.
TimeoutStartSec=120
# A failed probe must never stop the console from reaching its menu.
SuccessExitStatus=0 1
ExecStopPost=/bin/sh -c 'test -f /var/lib/penta/selftest.json || echo "{\"ran\":true,\"incomplete\":true}" > /var/lib/penta/selftest.json'

[Install]
WantedBy=penta.target
