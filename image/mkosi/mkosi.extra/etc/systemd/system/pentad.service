[Unit]
Description=PENTA system daemon
Documentation=file:///usr/share/penta/DESIGN.md
After=multi-user.target bluetooth.service
Wants=bluetooth.service

[Service]
Type=exec
ExecStart=/usr/bin/python3 -m pentad
Environment=PYTHONPATH=/opt/penta/daemon
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=1

# Needs raw input and hidraw: the PS button has to be readable while a game
# holds focus, and adaptive triggers only exist over raw HID.
DeviceAllow=char-input rw
DeviceAllow=char-hidraw rw
SupplementaryGroups=input

# read-only, not yes: pentad reads Steam's manifests out of the penta user's
# home. ProtectHome=yes hides /home entirely and the library is always empty.
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
NoNewPrivileges=yes

[Install]
WantedBy=penta.target
