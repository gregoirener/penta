[Unit]
Description=PENTA boot beacon
After=pentad.service greetd.service
# Deliberately no Requires/Wants on those: if pentad is crash-looping or greetd
# cannot start a compositor, that is exactly when knowing the boot got this far
# matters most. After= orders us without tying our fate to theirs.

[Service]
Type=oneshot
RemainAfterExit=yes
# A successful boot is otherwise indistinguishable from a hang. This writes one
# line saying how far the stack actually got.
#
# To /dev/kmsg *and* /dev/console, because they are not the same place: kmsg
# reaches every registered console (so the serial port, so CI), /dev/console
# reaches whichever is last on the command line (so the laptop panel). Writing
# to only one meant it was always invisible from wherever you were looking.
ExecStart=/usr/bin/penta-beacon

[Install]
WantedBy=penta.target
